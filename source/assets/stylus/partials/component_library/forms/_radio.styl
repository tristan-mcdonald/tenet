/**
  * Radio buttons. Group the options in a `fieldset` with the classes `form_component` and
  * `form_component--radio`, labelled by a `legend` with the class `form_component__label`.
  */
.form_component

    &--radio
        gap sp(1/3)

    &__radio_option
        display flex
        flex-direction row
        align-items flex-start
        gap sp(1/3)
        w-full()
        max-width ($ll)ch

    &__radio
        transition($properties: "border-color, background-size")
        appearance none
        cursor pointer
        flex 0 0 auto
        margin 0
        margin-top "calc((%s - 1.25rem) / 2)" % (($lh--heading)em)
        height 1.25rem
        width @height
        border-radius 50%
        border $bw--half solid $cl--action--secondary
        background-color $cl--form--background
        background-image radial-gradient(circle closest-side, $cl--form--selected 0 calc(100% - 1px), transparent 100%)
        background-repeat no-repeat
        background-position center
        background-size 0 0

        &:hover
            border-color $cl--form--input-border--interact

        &:checked
            border-color $cl--form--selected
            background-size 60% 60%

    &__radio_label
        cursor pointer
        line-height $lh--heading
        color $cl--text--body
