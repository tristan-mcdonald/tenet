/**
  * Select elements. The first option should have an empty value, such as
  * `<option value=""></option>`, which allows the label to rest inside the field until the user
  * makes a selection.
  *
  * In browsers which support customisable select elements (`appearance: base-select`), the
  * drop-down list of options is styled too. Other browsers display their native list of options.
  */
.form_component

    &--select
        floating-label()

        &:has(.form_component__select:focus)
        &:has(.form_component__select option:checked:not([value=""]))
            floated-label()

        // A chevron to show that the field opens a list of options.
        &::after
            content ""
            transition($properties: "rotate")
            pointer-events none
            pos-a($z-index: 10)
            top "calc(%s + %s)" % (sp(2/3) $bw--half)
            right sp(2/3)
            height .5em
            width @height
            border-right $bw solid $cl--form--selected
            border-bottom $bw solid $cl--form--selected
            rotate 45deg

    &__select
        input-standard()
        appearance none
        cursor pointer
        padding-right sp(2)

        option[value=""]
            color $cl--text--disabled

/**
  * Customisable select elements. The native picker icon replaces the chevron above.
  */
@supports (appearance: base-select)

    .form_component--select::after
        display none

    .form_component__select

        &
        &::picker(select)
            appearance base-select

        &::picker-icon
            transition($properties: "rotate")
            color $cl--form--selected

        &:open::picker-icon
            rotate 180deg

        &::picker(select)
            bxsh-static()
            margin-top sp(1/6)
            border-radius $bdrs
            border $bw--half solid $cl--form--input-border--interact
            background-color $cl--form--background
            padding sp(1/3) 0

        option
            transition($properties: "background-color, color")
            padding sp(1/4) sp(2/3)
            line-height $lh--heading

            &:hover
            &:focus
                background-color $cl--action--background
                color $cl--action--interact

            &:checked
                display-as-strong()

            &::checkmark
                color $cl--form--selected
