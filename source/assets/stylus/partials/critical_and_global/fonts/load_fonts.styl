/**
  * Fonts are loaded as variable WOFF2 files. A single variable font file contains a typeface's full
  * range of weights (and, for both typefaces below, optical sizes), so we need only one file per
  * style rather than one per weight, and every browser that supports variable fonts supports WOFF2.
  *
  * - Inter is used for body text. It's a single file per style, containing its full character set.
  * - Fraunces is used for headings. Its files are split into Latin and Latin Extended subsets, and
  *   `unicode-range` ensures that the browser downloads a subset only if the page uses it.
  *
  * Preload the font files used above the fold from your HTML's `head`, for example:
  * `<link rel="preload" href="…/inter--variable.woff2" as="font" type="font/woff2" crossorigin>`
  */
@font-face
    font-family "inter"
    src url("../fonts/inter/inter--variable.woff2") format("woff2")
    font-weight 100 900
    font-style normal
    font-display swap

@font-face
    font-family "inter"
    src url("../fonts/inter/inter--variable--italic.woff2") format("woff2")
    font-weight 100 900
    font-style italic
    font-display swap

@font-face
    font-family "fraunces"
    src url("../fonts/fraunces/fraunces--variable--latin.woff2") format("woff2")
    font-weight 100 900
    font-style normal
    font-display swap
    unicode-range U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD

@font-face
    font-family "fraunces"
    src url("../fonts/fraunces/fraunces--variable--latin-ext.woff2") format("woff2")
    font-weight 100 900
    font-style normal
    font-display swap
    unicode-range U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF

@font-face
    font-family "fraunces"
    src url("../fonts/fraunces/fraunces--variable--italic--latin.woff2") format("woff2")
    font-weight 100 900
    font-style italic
    font-display swap
    unicode-range U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD

@font-face
    font-family "fraunces"
    src url("../fonts/fraunces/fraunces--variable--italic--latin-ext.woff2") format("woff2")
    font-weight 100 900
    font-style italic
    font-display swap
    unicode-range U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF

/**
  * Metric-matched fallback fonts. These use a locally installed system font, adjusted with
  * `size-adjust` and the `*-override` descriptors so that its dimensions match the web font's. This
  * minimises layout shift when the web font loads and replaces the fallback.
  *
  * The values were calculated from each typeface's metrics (Fraunces at weight 600, as used for
  * headings). If you change a typeface, recalculate them with a tool such as Capsize
  * (https://seek-oss.github.io/capsize) or https://screenspan.net/fallback.
  */
@font-face
    font-family "inter--fallback"
    src local("Arial"), local("ArialMT")
    font-style normal
    size-adjust 107.33%
    ascent-override 90.26%
    descent-override 22.47%
    line-gap-override 0%

@font-face
    font-family "inter--fallback"
    src local("Arial Italic"), local("Arial-ItalicMT")
    font-style italic
    size-adjust 108%
    ascent-override 89.7%
    descent-override 22.33%
    line-gap-override 0%

@font-face
    font-family "fraunces--fallback"
    src local("Georgia")
    font-style normal
    size-adjust 99.32%
    ascent-override 98.47%
    descent-override 25.68%
    line-gap-override 0%

@font-face
    font-family "fraunces--fallback"
    src local("Georgia Italic"), local("Georgia-Italic")
    font-style italic
    size-adjust 94.77%
    ascent-override 103.2%
    descent-override 26.91%
    line-gap-override 0%
