/**
  * Non-semantic colours, to be referenced in semantic variable names if needed. You may use the
  * `modify-hsla` and `set-lightness` functions to create variations of these colours. Generate these
  * colour names from your HSLA values here: https://colornamer.robertcooper.me
  */
$cl--illuminating-emerald = hsla(161.3, 53%, 39.2%, 1)
$cl--tupelo-honey         = hsla(44.9, 46.4%, 53.1%, 1)
$cl--water-town           = hsla(222.1, 39%, 56.3%, 1)

/**
  * Every semantic colour family below the interface and text colours follows the same scale, from
  * lightest to darkest, derived from the family's base colour:
  *
  * `--background`  a faint tint, for the background of a containing element.
  * `--subtle`      a light tint, for borders and secondary details.
  * `--secondary`   a mid tint, for icons and accents.
  * (no suffix)     the base colour.
  * `--interact`    a stronger shade, for hover, focus, and active states.
  *
  * Set the base colour, and the remaining steps will follow. Override an individual step only if
  * the derived value doesn't suit the hue.
  */
$cl-step--background = 96%
$cl-step--subtle     = 86%
$cl-step--secondary  = 72%

/**
  * Layout delineation colours, from lightest to darkest.
  */
$cl--interface--high   = hsla(180, 29.4%, 96.7%, 1)
$cl--interface--light  = hsla(180, 20%, 92.2%, 1)
$cl--interface--border = hsla(180, 15%, 86%, 1)
$cl--interface         = hsla(180, 10.5%, 70.2%, 1)
$cl--interface--dark   = hsla(180, 10%, 24%, 1)
$cl--interface--low    = hsla(180, 6%, 10%, 1)
$cl--interface--black  = hsla(180, 8%, 4%, 1)

/**
  * Text colours. It often works well to use the same hue as the interface colour values.
  */
$cl--text--disabled              = hsla(180, 6%, 62%, 1)
$cl--text--metadata              = hsla(180, 8%, 45%, 1)
$cl--text--body                  = hsla(180, 14.3%, 26%, 1)
$cl--text--heading               = hsla(180, 22.8%, 13%, 1)
$cl--text--body--dark-background = alpha(white, .8)

/**
  * Action colours, to show the user they can interact with an element.
  */
$cl--action             = $cl--water-town
$cl--action--background = set-lightness($color: $cl--action, $lightness: $cl-step--background)
$cl--action--subtle     = set-lightness($color: $cl--action, $lightness: $cl-step--subtle)
$cl--action--secondary  = set-lightness($color: $cl--action, $lightness: $cl-step--secondary)
$cl--action--interact   = modify-hsla($color: $cl--action, $s: 10, $l: -10)

/**
  * Attention colours, to draw the user's attention to an element.
  */
$cl--attention             = $cl--tupelo-honey
$cl--attention--background = set-lightness($color: $cl--attention, $lightness: $cl-step--background)
$cl--attention--subtle     = set-lightness($color: $cl--attention, $lightness: $cl-step--subtle)
$cl--attention--secondary  = set-lightness($color: $cl--attention, $lightness: $cl-step--secondary)
$cl--attention--interact   = modify-hsla($color: $cl--attention, $s: 10, $l: -10)

/**
  * Anchor colours.
  */
$cl--anchor           = $cl--illuminating-emerald
$cl--anchor--interact = modify-hsla($color: $cl--anchor, $s: 10, $l: -10)

/**
  * Utility colours, to communicate the status of an element or an operation.
  */
$cl--success             = hsla(160, 55%, 46%, 1)
$cl--success--background = set-lightness($color: $cl--success, $lightness: $cl-step--background)
$cl--success--subtle     = set-lightness($color: $cl--success, $lightness: $cl-step--subtle)
$cl--success--secondary  = set-lightness($color: $cl--success, $lightness: $cl-step--secondary)
$cl--success--interact   = modify-hsla($color: $cl--success, $s: 10, $l: -10)

$cl--error             = hsla(350, 79.4%, 50.4%, 1)
$cl--error--background = set-lightness($color: $cl--error, $lightness: $cl-step--background)
$cl--error--subtle     = set-lightness($color: $cl--error, $lightness: $cl-step--subtle)
$cl--error--secondary  = set-lightness($color: $cl--error, $lightness: $cl-step--secondary)
$cl--error--interact   = modify-hsla($color: $cl--error, $s: 10, $l: -10)

$cl--info             = hsla(200.5, 40.1%, 44.1%, 1)
$cl--info--background = set-lightness($color: $cl--info, $lightness: $cl-step--background)
$cl--info--subtle     = set-lightness($color: $cl--info, $lightness: $cl-step--subtle)
$cl--info--secondary  = set-lightness($color: $cl--info, $lightness: $cl-step--secondary)
$cl--info--interact   = modify-hsla($color: $cl--info, $s: 10, $l: -10)

$cl--warning             = hsla(14.5, 100%, 62%, 1)
$cl--warning--background = set-lightness($color: $cl--warning, $lightness: $cl-step--background)
$cl--warning--subtle     = set-lightness($color: $cl--warning, $lightness: $cl-step--subtle)
$cl--warning--secondary  = set-lightness($color: $cl--warning, $lightness: $cl-step--secondary)
$cl--warning--interact   = modify-hsla($color: $cl--warning, $s: 10, $l: -10)

/**
  * Focus colour, for the focus styles applied to keyboard users.
  */
$cl--focus = $cl--attention

/**
  * Backdrop colour, shown behind a modal dialog.
  */
$cl--dialog--background = modify-hsla($color: $cl--interface--dark, $a: -.5)
