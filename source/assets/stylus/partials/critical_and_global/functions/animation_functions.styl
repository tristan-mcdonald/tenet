/**
  * Function for transitions. This adds a will-change value for each property chosen. Avoid using
  * `all` for the `will-change` value, as you will very quickly hit the browser's `will-change`
  * memory consumption limit. `$delay` accepts a comma-separated list, to delay each property
  * individually, for example `$delay: "0s, .1s"`.
  */
transition(
    $easing = ease-out,
    $delay = "0s",
    $properties = "background-color, box-shadow",
    $time = $trsdu,
)
    will-change unquote($properties)
    transition-property unquote($properties)
    transition-duration $time
    transition-delay unquote($delay)
    transition-timing-function $easing

/**
  * Function to lift an element vertically on interaction. remember to specify a transition for the
  * element with a value of `transform`; this has been ommitted here to allow for multiple
  * transition values.
  */
raise-up($distance = -2px)

    &:focus
    &:hover
        transform translateY($distance)
