/**
  * Specify the font sizes and scaling ratios for the app's typography. See
  * `functions/interpolation_functions.styl` for an explanation of this function.
  */
:root
    // @stylint off
    interpolation(
        $properties: "font-size",
        $min-screen: 480px,
        $max-screen: 1680px,
        $min-value: 13px,
        $max-value: 19px
    )
    // @stylint on

/**
  * Specify options browsers should use when rendering text.
  */
html
    text-rendering optimizeLegibility
    -webkit-font-smoothing antialiased
    -moz-osx-font-smoothing grayscale
    word-break break-word

/**
  * Specify text styles for generic text.
  */
body
select
input
textarea
    font-family $ff--body
    font-weight $fw--normal
    line-height $lh--body
    font-size inherit
    letter-spacing $ls--body
    color $cl--text--body

/**
  * Specify text styles for heading text. There are no styles for any heading levels lower than h4,
  * as content editors tend to use h5 and h6 as a means of editing the size of text, rather than
  * semantically.
  */
h1
h2
h3
h4
    display block
    text-wrap balance
    color $cl--text--heading

    a
        content-anchor()

h1
    display-as-heading($heading-level: 1)

h2
    display-as-heading($heading-level: 2)

h3
    display-as-heading($heading-level: 3)

h4
    display-as-heading($heading-level: 4)

/**
  * Specify text styles for copy text.
  */
p
    width auto
    max-width 100%
    font-family $ff--body
    font-size $fz--base
    line-height $lh--body
    letter-spacing $ls--body
    color $cl--text--body

    /**
      * Add this class to paragraph content to constrain it to a readable line-length.
      * Avoid setting paragraph line-lengths globally so that they don't need to be overridden.
      */
    .reading_content &
    &.reading_content
        width ($ll)ch

        > a
            content-anchor()

    /**
      * Vertical spacing between paragraphs is applied only within `.reading_content`.
      */
    .reading_content * + &
        margin-top sp(1)

    .reading_content h1 + &
    .reading_content h2 + &
    .reading_content h3 + &
        margin-top sp(1/3)

    .reading_content h4 + &
        margin-top sp(1/2)

/**
  * Specify generic anchor styles.
  */
a
a:visited
    transition(properties: "box-shadow, color")
    cursor pointer
    text-decoration none

/**
  * Specify styles for strong text.
  */
b
strong
    display-as-strong()

/**
  * Specify styles for italic text. Each font family's italic style is a separate variable font file,
  * which the browser selects according to `font-style`.
  */
i
em
    font-style italic

/**
  * Specify styles for superscript and subscript text.
  */
sup
sub
    fz--minus-one()

sup
    vertical-align super

sub
    vertical-align sub

/**
  * Specify styles for selected text.
  */
::selection
    background-color $cl--text--body
    text-shadow 0 0 .1em $cl--text--heading
    -webkit-text-fill-color white // Override text which is filled with a clipped background gradient.
    color white

/**
  * Specify styles for lists in reading content.
  */
.reading_content
    width 100%

    ul
    ol
    dl
        display block
        width 100%
        max-width ($ll)ch
        padding-left 3ch

    & * + ul
    & * + ol
    & * + dl
        margin-top sp(2/3)

    ul
        list-style-type disc

    ul ul
        list-style-type circle

    ul ul ul
        list-style-type square

    ol
        list-style-type decimal

    ol ol
        list-style-type lower-alpha

    ol ol ol
        list-style-type lower-roman

    li
        padding-left 1.3ch
        width 100%
        max-width ($ll)ch

        a
            content-anchor()

        ul
        ol

            &:first-child
                margin-top sp(1/2)

    * + li
        margin-top sp(1/2)

    * + pre
        margin-top sp(1)

/**
  * Specify styles for preformatted text, such as a block of code.
  */
pre
    width 100%
    max-width ($ll)ch
    white-space pre-wrap
    overflow-wrap break-word
    display-as-monospaced()

    a
        content-anchor()

/**
  * Specify styles for inline code.
  */
code
    border-radius $bdrs
    background-color $cl--interface--dark
    padding 0 .3em .1em
    display-as-monospaced()
    fz--minus-one()
    color white

    pre &
        border-radius 0
        background-color transparent
        padding 0
        font-size inherit
        color inherit

/**
  * Specify styles for description lists without a class. Each term and its description(s) should
  * be wrapped in a `div`, which displays them side-by-side.
  */
dl:not([class])
    w-full()

    > div:not([class])
        display flex
        flex-direction row
        align-items flex-start
        gap sp(1/3)
        w-full()

        &:not(:first-child)
            margin-top sp(2/3)

    dt:not([class])
    dd:not([class])
        display block
        line-height $lh--heading

    dt:not([class])
        flex 0 0 8rem
        display-as-strong()

    dd:not([class])
        flex 1 1 auto
